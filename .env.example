# ============================================================
# 環境變數範本 — 複製成 .env 後填入實際值(.env 不可進 git)
#   cp .env.example .env
# ============================================================

# ---- PostgreSQL ----
# 注意:DB 連線帳號採最小權限,不要用 superuser 給應用程式使用。
POSTGRES_DB=shitian
POSTGRES_USER=shitian_app
POSTGRES_PASSWORD=change_me_in_real_env

# 後端用的完整連線字串(Phase 1 才會真的連)
# 格式:postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://shitian_app:change_me_in_real_env@db:5432/shitian

# ---- Flask / 後端 ----
# 用 `python -c "import secrets; print(secrets.token_hex(32))"` 產生
SECRET_KEY=change_me_to_a_long_random_string
FLASK_ENV=production

# session cookie 安全性(本機開發若沒走 https,可暫時設 false)
SESSION_COOKIE_SECURE=true

# 後端在 Caddy 之後,信任 X-Forwarded-*(取得真實 client IP);正式 true
TRUST_PROXY=true

# rate limit 儲存:開發 memory://;正式多 worker 用 Redis
RATELIMIT_STORAGE_URI=memory://

# CORS / 前端來源(本機開發用)
FRONTEND_ORIGIN=http://localhost:5173

# ---- Caddy / 反向代理 ----
# 正式環境填你的網域;本機開發可用 localhost
SITE_ADDRESS=localhost

# ---- PDF / 列印(Phase 4 / 7)----
# PDF 封存資料夾(正式環境掛 NAS 路徑,如 /archive)
ARCHIVE_DIR=archive
# CUPS 佇列名稱(在 NAS/CUPS 上預先建立)
CUPS_NORMAL_QUEUE=normal
CUPS_DOTMATRIX_QUEUE=dotmatrix

# ---- 單據抬頭(印在 PDF 上)----
COMPANY_NAME_1=旭田興有限公司
COMPANY_NAME_2=旭田工業社
COMPANY_ADDRESS=台中市大里區仁義路112號
COMPANY_TEL=04-2491-4552
COMPANY_FAX=04-2491-1453

# ============================================================
# 聊天機器人(Text-to-SQL,LangGraph + OpenAI)— 詳見 docs/chatbot.md
# 不填 OPENAI_API_KEY 時,聊天機器人會自動停用,其他功能不受影響。
# ============================================================
OPENAI_API_KEY=
CHATBOT_MODEL=gpt-4o-mini

# 【強烈建議】給聊天機器人專用的「唯讀」資料庫連線。
# 先在 PostgreSQL 建一個只有 SELECT 權限、且看不到 users/audit_log 的角色:
#   CREATE ROLE shitian_ro LOGIN PASSWORD 'a_strong_password';
#   GRANT CONNECT ON DATABASE shitian TO shitian_ro;
#   GRANT USAGE ON SCHEMA public TO shitian_ro;
#   GRANT SELECT ON companies, products, process_items, specs, orders, order_items TO shitian_ro;
#   -- 故意不授予 users / audit_log:連 SQL 都讀不到密碼雜湊與稽核紀錄(雙重保險)
# 不填則退回主 DATABASE_URL(查詢仍包在 READ ONLY 交易 + 多層防護)。
CHATBOT_DATABASE_URL=

# 查詢回傳列數上限 / SQL 逾時(毫秒)/ 記住的對話輪數
CHATBOT_MAX_ROWS=200
CHATBOT_SQL_TIMEOUT_MS=5000
CHATBOT_MEMORY_TURNS=6
