# ============================================================
# 正式環境範本 → 複製成 .env 並填入「真實的強密碼/網域」
#   cp .env.prod.example .env
# 搭配:docker compose up -d --build(下方 COMPOSE_FILE 已指定 prod 疊法)
# ============================================================

# 讓 docker compose 自動套用「基底 + 正式」兩個檔,之後打 docker compose 就不必每次加 -f。
# (Linux/NAS 用冒號分隔;此檔僅正式環境用)
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---- PostgreSQL(務必改強密碼;帳號採最小權限,勿用 superuser)----
POSTGRES_DB=shitian
POSTGRES_USER=shitian_app
POSTGRES_PASSWORD=__CHANGE_ME_strong_password__

DATABASE_URL=postgresql+psycopg://shitian_app:__CHANGE_ME_strong_password__@db:5432/shitian

# ---- Flask / 後端 ----
# 產生:python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=__CHANGE_ME_long_random_hex__
FLASK_ENV=production

# 正式走 HTTPS;prod compose 也會強制這兩個為 true
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true

# 多 worker 共用限流計數
RATELIMIT_STORAGE_URI=redis://redis:6379

# 你的網域(Caddy 自動申請 Let's Encrypt 憑證、HTTP 轉 HTTPS)
SITE_ADDRESS=your.domain.tw
FRONTEND_ORIGIN=https://your.domain.tw

# ---- PDF / 列印(ARCHIVE_DIR 建議掛 NAS 路徑)----
ARCHIVE_DIR=/archive
CUPS_NORMAL_QUEUE=normal
CUPS_DOTMATRIX_QUEUE=dotmatrix

# ---- 單據抬頭 ----
COMPANY_NAME_1=旭田興有限公司
COMPANY_NAME_2=旭田工業社
COMPANY_ADDRESS=台中市大里區仁義路112號
COMPANY_TEL=04-2491-4552
COMPANY_FAX=04-2491-1453
