# ============================================================
# 開發環境範本 → 複製成 .env(本機 venv 開發或 dev 容器用)
#   cp .env.dev.example .env
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=shitian
POSTGRES_USER=shitian_app
POSTGRES_PASSWORD=devpassword

# 容器內互連用 db:5432;若是本機 venv 連 dev 容器的 db,改用 localhost:5433
DATABASE_URL=postgresql+psycopg://shitian_app:devpassword@db:5432/shitian

# ---- Flask / 後端 ----
SECRET_KEY=dev-only-secret-not-for-production
FLASK_ENV=development

# 本機 venv 走 http 時設 false(否則 cookie 不送、登不進去)
SESSION_COOKIE_SECURE=false
TRUST_PROXY=true

# 開發:容器用 redis;本機 venv 沒 redis 時可改 memory://
RATELIMIT_STORAGE_URI=redis://redis:6379

FRONTEND_ORIGIN=http://localhost:5173
SITE_ADDRESS=localhost

# ---- PDF / 列印 ----
ARCHIVE_DIR=archive
CUPS_NORMAL_QUEUE=normal
CUPS_DOTMATRIX_QUEUE=dotmatrix

# ---- 單據抬頭 ----
COMPANY_NAME_1=旭田興有限公司
COMPANY_NAME_2=旭田工業社
COMPANY_ADDRESS=台中市大里區仁義路112號
COMPANY_TEL=04-2491-4552
COMPANY_FAX=04-2491-1453
